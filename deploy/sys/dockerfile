# 1. 更换基础镜像
# 去掉 "-alpine" 后缀，默认使用的是基于 Ubuntu 的镜像
# Ubuntu 的源里包含官方的 MySQL 8.0 客户端，完美兼容 caching_sha2_password
FROM eclipse-temurin:17-jre

# 设置工作目录
WORKDIR /app

# 复制jar文件
COPY sys.jar /app/

# 2. 安装官方 MySQL 客户端
# 注意：这里使用的是 apt-get 而不是 apk
# mysql-client 包在 Ubuntu 22.04+ 中对应的就是 MySQL 8.0 版本
RUN apt-get update && \
    apt-get install -y mysql-client && \
    rm -rf /var/lib/apt/lists/*

# 创建非root用户并设置权限
# Ubuntu 使用 useradd 而不是 adduser (语法略有不同，但为了通用这里使用 useradd)
RUN groupadd -r appgroup && useradd -r -g appgroup appuser && \
    chown -R appuser:appgroup /app

# 切换用户
USER appuser

# 设置Java运行参数
ENV JAVA_OPTS="-Xms256m -Xmx512m -XX:+UseContainerSupport"

# 暴露端口
EXPOSE 2121

# 启动命令
CMD ["sh", "-c", "exec java $JAVA_OPTS -jar /app/sys.jar"]